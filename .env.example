# Enterprise Resource & Operations Management System (EROMS)
# Environment Configuration Template

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="EROMS - Enterprise Resource & Operations Management System"
API_V1_PREFIX=/api/v1
SECRET_KEY=enterprise_super_secret_jwt_key_change_in_production_min_32_bytes_long_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=eroms_admin
DB_PASSWORD=eroms_secure_password_2026
DB_NAME=eroms_enterprise_db

# Assembled Database URLs
DATABASE_URL=postgresql://eroms_admin:eroms_secure_password_2026@localhost:5432/eroms_enterprise_db
ASYNC_DATABASE_URL=postgresql+asyncpg://eroms_admin:eroms_secure_password_2026@localhost:5432/eroms_enterprise_db

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Test Database Configuration
TEST_DB_NAME=eroms_test_db
TEST_DATABASE_URL=postgresql://eroms_admin:eroms_secure_password_2026@localhost:5432/eroms_test_db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# Audit Logging & System Defaults
ENABLE_SQL_AUDIT_LOGS=True
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
